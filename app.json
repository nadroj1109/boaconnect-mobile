{
  "expo": {
    "name": "BOAConnect",
    "slug": "boaconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/boaconnect-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.jrdn1109.boaconnect",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/boaconnect-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/boaconnect-logo.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "5ac4f911-db9f-4ede-a9fc-cec8a9070fb3"
      }
    }
  }
}
